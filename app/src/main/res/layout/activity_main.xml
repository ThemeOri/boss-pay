<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg" android:fillViewport="true">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/header_bg" android:orientation="vertical"
            android:padding="22dp" android:paddingTop="30dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Visa OTP Bridge" android:textColor="#FFFFFF"
                android:textSize="22sp" android:textStyle="bold"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ভিসা পেমেন্টের OTP ব্রাউজারে পাঠায়" android:textColor="#E8DEF8"
                android:textSize="13sp" android:paddingTop="2dp"/>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Status pill -->
            <TextView android:id="@+id/statusPill" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="○ বন্ধ"
                android:background="@drawable/pill_off" android:paddingLeft="14dp"
                android:paddingRight="14dp" android:paddingTop="7dp" android:paddingBottom="7dp"
                android:textSize="13sp" android:textStyle="bold" android:textColor="@color/ink"
                android:layout_marginBottom="6dp"/>

            <TextView android:id="@+id/deliver" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="" android:visibility="gone"
                android:textColor="#166534" android:textSize="12.5sp" android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- Connect card -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/card_bg" android:orientation="vertical" android:padding="16dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ব্রাউজারের Pair ID" android:textColor="@color/ink"
                    android:textSize="13sp" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="এক্সটেনশনের OTP ট্যাবে যে কোডটা দেখাচ্ছে সেটাই বসান" 
                    android:textColor="@color/muted" android:textSize="11.5sp" android:paddingBottom="8dp"/>

                <EditText android:id="@+id/pair" android:layout_width="match_parent"
                    android:layout_height="54dp" android:background="@drawable/field_bg"
                    android:paddingLeft="14dp" android:paddingRight="14dp"
                    android:inputType="textCapCharacters" android:maxLength="12"
                    android:hint="যেমন: AB12CD" android:textColor="@color/brand"
                    android:textSize="22sp" android:textStyle="bold"
                    android:letterSpacing="0.2" android:gravity="center"/>

                <Button android:id="@+id/toggle" android:layout_width="match_parent"
                    android:layout_height="52dp" android:layout_marginTop="14dp"
                    android:background="@drawable/btn_go" android:text="কানেক্ট করুন"
                    android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold"
                    android:textAllCaps="false"/>
            </LinearLayout>

            <!-- Log card -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/card_bg" android:orientation="vertical"
                android:padding="16dp" android:layout_marginTop="14dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView android:layout_width="0dp" android:layout_weight="1"
                        android:layout_height="wrap_content" android:text="লগ" android:textStyle="bold"
                        android:textColor="@color/ink" android:textSize="14sp"/>
                    <Button android:id="@+id/test" android:layout_width="wrap_content"
                        android:layout_height="34dp" android:minWidth="0dp" android:paddingLeft="12dp"
                        android:paddingRight="12dp" android:background="@drawable/btn_outline"
                        android:text="টেস্ট" android:textColor="@color/brand" android:textSize="12sp"
                        android:textAllCaps="false"/>
                    <Button android:id="@+id/clearLog" android:layout_width="wrap_content"
                        android:layout_height="34dp" android:minWidth="0dp" android:paddingLeft="12dp"
                        android:paddingRight="12dp" android:layout_marginLeft="6dp"
                        android:background="@drawable/btn_outline" android:text="মুছুন"
                        android:textColor="@color/brand" android:textSize="12sp" android:textAllCaps="false"/>
                </LinearLayout>
                <TextView android:id="@+id/log" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:fontFamily="monospace"
                    android:textSize="12sp" android:textColor="@color/ink" android:paddingTop="8dp"
                    android:lineSpacingExtra="3dp"/>
            </LinearLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="📶 দুই সিমের OTP-ই ধরবে। পেছনে চালু রাখতে Settings এ এই অ্যাপের ব্যাটারি অপটিমাইজেশন বন্ধ রাখুন।"
                android:textColor="@color/muted" android:textSize="11.5sp" android:paddingTop="14dp"
                android:paddingLeft="4dp" android:paddingRight="4dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
